# Database Connection (Supabase PostgreSQL)
# Option A: Direct Connection (IPv6 verified on this host)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.sxfkhuvybqbubupofttm.supabase.co:5432/postgres"

# Option B: Connection Pooler (Session mode, port 5432)
# DATABASE_URL="postgresql://postgres.sxfkhuvybqbubupofttm:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.sxfkhuvybqbubupofttm.supabase.co:5432/postgres"

# JWT Secret for Session & Access Tokens (Must be a unique, high-entropy 256-bit secret)
# Generate locally via: node server/scripts/manage-env.cjs --init-secret
JWT_SECRET="replace-with-locally-generated-high-entropy-secret"

# Google Cloud Vision (OCR)
GOOGLE_APPLICATION_CREDENTIALS="./gcp-credentials.json"

# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
MAX_UPLOAD_MB=10
