{
  "name": "medminders-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client/web",
    "client/mobile",
    "server"
  ],
  "scripts": {
    "build:web": "npm run build --workspace=client/web",
    "build:server": "npm run build --workspace=server",
    "test:server": "npm run test --workspace=server",
    "build": "npm run build:server && npm run build:web"
  }
}
